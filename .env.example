# ConsultX — Environment Variable Reference
#
# Copy to `.env.local` and fill in real values. Never commit files with real values.
# All `.env.*` files are gitignored except this example.

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Exposed to the browser. Only ever put public/publishable keys here.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Payment widget public key (Moyasar)
VITE_MOYASAR_PUBLISHABLE_KEY=

# Base URL used to build campaign links
VITE_APP_URL=https://www.consultx.app

# ─── Frontend feature flags ───────────────────────────────────────────────────
# Set to "true" / "1" to enable. Omit or leave empty to disable.

VITE_ANALYTICAL_REPORTS_ENABLED=
VITE_PLAN_LAB_ENABLED=
VITE_PLAN_LAB_IFRAME_URL=
VITE_FOUNDING10_LIVE=
VITE_EID50_LIVE=

# ─── Node scripts (scripts/, orchestrator.cjs) ────────────────────────────────
# Server-side only. Never expose these to the browser.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Used by scripts/setup-admins.cjs
ADMIN_EMAILS=
ADMIN_PASSWORD=

# Used by scripts/test-gemini.mjs, list-models.mjs, test-embeddings.mjs
GOOGLE_GEMINI_API_KEY=

# Supabase Auth custom SMTP password (Resend API key)
SUPABASE_AUTH_EMAIL_SMTP_PASS=

# ─── Supabase Edge Function secrets ───────────────────────────────────────────
# NOT read from this file. Set them on the Supabase project instead:
#   supabase secrets set KEY=value
#
#   GOOGLE_GEMINI_API_KEY        AI engine (fire-safety-chat)
#   SUPABASE_SERVICE_ROLE_KEY    privileged DB access
#   MOYASAR_SECRET_KEY           payments
#   MOYASAR_WEBHOOK_SECRET       webhook signature verification
#   TAP_SECRET_KEY               payments (legacy gateway)
#   RESEND_API_KEY               transactional + campaign email
#   FROM_EMAIL                   defaults to noreply@consultx.app
#   REPLY_TO                     defaults to support@consultx.app
#   CRON_SECRET                  guards process-subscription-renewal
#   APP_ORIGIN / APP_URL         redirect targets for payment flows
#
#   Advisory Brain B2 feature flags (set to "1" to enable):
#   ADVISORY_BRAIN_B2_ENABLED
#   ADVISORY_BRAIN_B2_ROUTER_ENABLED
#   ADVISORY_BRAIN_B2_EVIDENCE_ENABLED
#   ADVISORY_DYNAMIC_THINKING_ENABLED
